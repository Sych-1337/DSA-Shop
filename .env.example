NODE_ENV=development
APP_URL=http://localhost:3000

# Local Docker Postgres (dev)
# DATABASE_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public
# DIRECT_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public

# --- Supabase (Vercel / prod) ---
# Project Settings → Database → Connection string
# Use Transaction pooler (port 6543) for the app on Vercel:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Use Direct (port 5432) for migrations / seed from your laptop:
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Or Session mode / direct host from Supabase UI.
DATABASE_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public
DIRECT_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public
DATABASE_SSL=false
# DATABASE_POOL_MAX=1

BETTER_AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!

# local = public/uploads (dev only — files vanish on Vercel)
# supabase = Supabase Storage (recommended for Vercel)
STORAGE_PROVIDER=local
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

SHIPPING_PROVIDER=mock

EMAIL_PROVIDER=mock
EMAIL_FROM=D&A <noreply@da-shop.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

CRON_SECRET=dev-cron-secret
ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

# Analytics: mock | firebase (GA4 / Firebase Analytics)
ANALYTICS_PROVIDER=mock
GA_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
GA4_API_SECRET=

# Local only — MUST be false/unset on Vercel (NODE_ENV=production)
ADMIN_AUTH_BYPASS=true
