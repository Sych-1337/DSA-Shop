NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public
DIRECT_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public

BETTER_AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

SEED_ADMIN_EMAIL=admin@kawaiko.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!

# local = public/uploads (dev); s3 = same for now until S3 adapter; memory = no disk write
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

SHIPPING_PROVIDER=mock

EMAIL_PROVIDER=mock
EMAIL_FROM=D&A <noreply@da-shop.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

CRON_SECRET=dev-cron-secret
ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

# Analytics: mock | firebase (GA4 / Firebase Analytics)
ANALYTICS_PROVIDER=mock
GA_MEASUREMENT_ID=
# Firebase web app (Console → Project settings). Measurement ID is enough for client gtag.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional: GA4 Measurement Protocol for server-side purchase events
GA4_API_SECRET=

# Local only — ignored when NODE_ENV=production
ADMIN_AUTH_BYPASS=true

