NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public
DIRECT_URL=postgresql://kawaiko:kawaiko@localhost:5432/kawaiko?schema=public
DATABASE_SSL=false
# DATABASE_POOL_MAX=5

BETTER_AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins (onrender while custom-domain SSL pending)
AUTH_TRUSTED_ORIGINS=

# Optional social login (Better Auth). Leave empty until OAuth apps are ready.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

SEED_ADMIN_EMAIL=admin@da-shop.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!

# local = public/uploads (dev + Render with persistent disk)
STORAGE_PROVIDER=local

# mock | wayforpay — mock settle is DISABLED when NODE_ENV=production
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

# WayForPay (when PAYMENT_PROVIDER=wayforpay)
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_MERCHANT_DOMAIN=

# FOP bank transfer (shown on pay page when method=BANK_TRANSFER)
# Defaults are already in code for soft launch; set env to override.
FOP_NAME=Семенова Дар'я Миколаївна
FOP_IBAN=UA443006140000026000500594304
FOP_EDRPOU=3017916040
FOP_BANK_NAME=АТ Креді Агріколь
FOP_PAYMENT_PURPOSE_TEMPLATE=Оплата за {orderNumber}
FOP_QR_URL=/payments/fop-qr.png

SHIPPING_PROVIDER=mock

# mock | smtp | resend
EMAIL_PROVIDER=mock
EMAIL_FROM=D&A <noreply@da-shop.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

CRON_SECRET=dev-cron-secret
# Hours before unpaid prepaid orders are cancelled (reservations released)
UNPAID_ORDER_CANCEL_HOURS=48
ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

ANALYTICS_PROVIDER=mock
GA_MEASUREMENT_ID=

# Local only — MUST be false/unset on Render
ADMIN_AUTH_BYPASS=true
